# Répertoire des CSV (hors de l'app).
# - Sans Docker : chemin relatif au dossier de l'app, ou absolu.
# - Avec Docker : chemin sur ta machine, il commence par ./ ou ../ ou est absolu.
#   Il est monté dans le conteneur, rien d'autre à configurer.
CSV_DIR=../work/analyses

# Port du site
PORT=3000

# Détection des changements de fichiers par polling.
# Nécessaire avec Docker sur Mac/Windows. Mets false sans Docker (valeur par défaut).
WATCH_POLLING=true
